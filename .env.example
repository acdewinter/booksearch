# All settings are optional.

# Port the app listens on.
PORT=3000

# Where the database and the uploaded list are kept.
# In Docker this is /data (mount a volume there).
# DATA_DIR=./data

# Set a password to require sign-in for the whole app (a sign-in page).
# Leave empty for no password sign-in.
APP_PASSWORD=

# Optional: also require this exact username with the password.
APP_USERNAME=

# Sign in with Hardcover, and see your Hardcover library in the app.
# Make an app at https://hardcover.app/account/developer-apps (type "Web app
# (server-side)") and copy its client id and secret here. Give it the scopes
# read:me:content, read:library and read:lists (and read:catalog:search, to
# tie downloaded files to any book on Hardcover), and register the redirect URI
# <address of this app>/oauth/callback
HARDCOVER_CLIENT_ID=
HARDCOVER_CLIENT_SECRET=

# Hardcover usernames that may sign in, separated by commas. Empty = only the
# first account that signs in (it becomes the owner of this app).
HARDCOVER_ALLOWED_USERS=

# The address people open the app at, such as https://books.example.com. It is
# what the redirect URI above is built from. Empty = worked out from each
# request, which is right for localhost and behind most reverse proxies.
APP_URL=

# Largest list file that can be uploaded, in MB.
MAX_UPLOAD_MB=512

# Where files received over IRC are saved. Default: a "downloads" folder
# inside DATA_DIR (in Docker: /downloads, mount your folder there).
# DOWNLOAD_DIR=./data/downloads

# With docker compose: the folder on this machine that is mounted at /downloads.
# DOWNLOAD_PATH=./downloads

# Only for senders behind a firewall (reverse DCC): ports this app may accept
# connections on. They must be forwarded from your router to this machine.
# DCC_PORTS=50000-50010
# Your public IP address, if the app cannot work it out by itself.
# DCC_PUBLIC_IP=
