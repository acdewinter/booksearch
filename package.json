{
  "name": "shelfmark",
  "version": "1.2.0",
  "description": "Search an audiobook command list, request files over IRC and receive them over DCC, starting from your Hardcover library if you like.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch server/index.js",
    "import": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/import-cli.js",
    "fake-irc": "node dev/fake-irc.js",
    "fake-hardcover": "node dev/fake-hardcover.js",
    "test": "node --disable-warning=ExperimentalWarning --test"
  }
}
