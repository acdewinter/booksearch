# All settings are optional.

# Port the app listens on.
PORT=3000

# Where the database and the uploaded list are kept.
# In Docker this is /data (mount a volume there).
# DATA_DIR=./data

# Set a password to require sign-in for the whole app (browser sign-in prompt).
# Leave empty for no sign-in.
APP_PASSWORD=

# Optional: also require this exact username. Empty = any username works.
APP_USERNAME=

# Largest list file that can be uploaded, in MB.
MAX_UPLOAD_MB=512
